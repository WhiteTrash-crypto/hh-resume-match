# Server (Netlify env / local .env)
# Collect mode default (env). Runtime override: POST /api/scrape-mode with HH_OPS_KEY
# Values: apify | fetch | browser
HH_SCRAPE_MODE=apify
# Ops key to switch scrape mode without redeploy (header X-Ops-Key)
HH_OPS_KEY=
# Apify (required when mode=apify)
APIFY_TOKEN=
APIFY_ACTOR=abotapi/hh-ru-jobs-scraper
# Optional: RU residential HTTP(S) proxy for fetch/browser modes (datacenter IPs get /vpncheeck)
HH_PROXY=
HH_USER_AGENT=
# Official api.hh.ru (optional: npm run compare:hh:api)
# Note: applicant API access discontinued by HH; employer app approval may be required
HH_API_ACCESS_TOKEN=
HH_API_USER_AGENT=
HH_CLIENT_ID=
HH_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=
GOOGLE_SA_JSON=
# Local only (not for Netlify):
GOOGLE_SA_PATH=
SESSION_SECRET=
# Google Sheet with access keys: column A = key, column B = remaining uses
ACCESS_KEYS_SHEET_ID=1vxccqrxcPzX1dOK3LM_q9YRvjRvhdoPGDAt-OIicRNk
ACCESS_KEYS_SHEET_TAB=Лист1
# Shown in UI so users can share their Sheet
PUBLIC_GOOGLE_SA_EMAIL=
VITE_GOOGLE_SA_EMAIL=
